<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi CRUD PBO - Pewarisan & Polimorfisme</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Container Utama -->
    <div class="container py-5">
        <h2 class="text-center mb-4">Aplikasi CRUD Berbasis PBO (Pewarisan & Polimorfisme)</h2>

        <!-- ================= PAGE 1: LOGIN ================= -->
        <div id="loginPage" class="card shadow p-4 mx-auto" style="max-width: 400px;">
            <h3 class="text-center mb-3">Login Sistem</h3>
            <div class="mb-3">
                <label for="usernameInput" class="form-label">Username</label>
                <input type="text" id="usernameInput" class="form-control" placeholder="Contoh: admin / staff">
            </div>
            <button class="btn btn-primary w-100" onclick="app.login()">Masuk</button>
        </div>

        <!-- ================= PAGE 2: TABEL DAFTAR USER (CRUD) ================= -->
        <div id="tablePage" class="card shadow p-4 d-none">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>Daftar Pengguna (User Management)</h3>
                <div>
                    <button class="btn btn-secondary btn-sm" onclick="app.showPage('profilePage')">Profil</button>
                    <button class="btn btn-danger btn-sm" onclick="app.logout()">Logout</button>
                </div>
            </div>

            <!-- Form Tambah/Edit -->
            <div class="card p-3 mb-4 bg-white border">
                <h5 id="formTitle">Tambah User Baru</h5>
                <input type="hidden" id="editIndex" value="">
                <div class="row g-3">
                    <div class="col-md-3">
                        <input type="text" id="inputName" class="form-control" placeholder="Nama Lengkap">
                    </div>
                    <div class="col-md-3">
                        <input type="email" id="inputEmail" class="form-control" placeholder="Email">
                    </div>
                    <div class="col-md-3">
                        <select id="inputRole" class="form-select" onchange="app.toggleRoleFields()">
                            <option value="Admin">Admin</option>
                            <option value="Staff">Staff</option>
                        </select>
                    </div>
                    <div class="col-md-3" id="extraFieldContainer">
                        <!-- Field dinamis berdasarkan role (Polimorfisme / Khusus Subclass) -->
                        <input type="text" id="inputExtra" class="form-control" placeholder="Admin Level (Cth: SuperAdmin)">
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success btn-sm" onclick="app.saveUser()">Simpan Data</button>
                    <button class="btn btn-secondary btn-sm" onclick="app.resetForm()">Batal</button>
                </div>
            </div>

            <!-- Tabel Data -->
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>No</th>
                            <th>Nama</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Aksi Khusus (Polimorfisme)</th>
                            <th>Aksi CRUD</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        <!-- Data dimasukkan via JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ================= PAGE 3: PROFILE ================= -->
        <div id="profilePage" class="card shadow p-4 mx-auto d-none" style="max-width: 500px;">
            <h3>Profil Pengguna Aktif</h3>
            <hr>
            <p><strong>Nama:</strong> <span id="profName">-</span></p>
            <p><strong>Email:</strong> <span id="profEmail">-</span></p>
            <p><strong>Role:</strong> <span id="profRole">-</span></p>
            <p><strong>Detail Hak Akses:</strong> <span id="profDetail">-</span></p>
            <button class="btn btn-primary mt-3" onclick="app.showPage('tablePage')">Kembali ke Tabel</button>
        </div>
    </div>

    <!-- JavaScript Logika PBO, Pewarisan, Polimorfisme, & CRUD -->
    <script>
        // ==========================================
        // 1. KONSEP PBO: PEWARISAN (INHERITANCE)
        // ==========================================

        // Superclass (Parent Class)
        class User {
            constructor(name, email, role) {
                this.name = name;
                this.email = email;
                this.role = role;
            }

            // Method dasar yang nantinya di-override (Polimorfisme)
            getDetails() {
                return `User umum dengan email: ${this.email}`;
            }
        }

        // Subclass 1 (Inheritance dari User)
        class Admin extends User {
            constructor(name, email, adminLevel) {
                super(name, email, 'Admin');
                this.adminLevel = adminLevel;
            }

            // ==========================================
            // 2. KONSEP PBO: POLIMORFISME (Method Overriding)
            // ==========================================
            getDetails() {
                return `Admin tingkat [${this.adminLevel}] memiliki akses penuh sistem.`;
            }
        }

        // Subclass 2 (Inheritance dari User)
        class Staff extends User {
            constructor(name, email, division) {
                super(name, email, 'Staff');
                this.division = division;
            }

            // Polimorfisme (Method Overriding berbeda perilaku dari Parent & Subclass lain)
            getDetails() {
                return `Staff divisi [${this.division}] bertugas mengelola operasional harian.`;
            }
        }

        // ==========================================
        // 3. CONTROLLER APLIKASI & LOCALSTORAGE CRUD
        // ==========================================
        class AppController {
            constructor() {
                this.currentUser = null;
                this.initDefaultData();
            }

            // Inisialisasi data awal ke localStorage jika kosong
            initDefaultData() {
                if (!localStorage.getItem('users')) {
                    const defaultUsers = [
                        new Admin("Budi Santoso", "budi@mail.com", "SuperAdmin"),
                        new Staff("Siti Rahma", "siti@mail.com", "Logistik")
                    ];
                    this.saveToStorage(defaultUsers);
                }
            }

            getUsers() {
                const rawData = JSON.parse(localStorage.getItem('users')) || [];
                // Rekonstruksi objek agar fungsi class (getDetails) tetap aktif setelah diambil dari JSON
                return rawData.map(item => {
                    if (item.role === 'Admin') {
                        return new Admin(item.name, item.email, item.adminLevel);
                    } else {
                        return new Staff(item.name, item.email, item.division);
                    }
                });
            }

            saveToStorage(users) {
                localStorage.setItem('users', JSON.stringify(users));
            }

            // Navigasi Antar Halaman
            showPage(pageId) {
                document.getElementById('loginPage').classList.add('d-none');
                document.getElementById('tablePage').classList.add('d-none');
                document.getElementById('profilePage').classList.add('d-none');

                document.getElementById(pageId).classList.remove('d-none');

                if (pageId === 'tablePage') {
                    this.renderTable();
                } else if (pageId === 'profilePage') {
                    this.renderProfile();
                }
            }

            login() {
                const username = document.getElementById('usernameInput').value.trim();
                if (!username) {
                    alert('Silakan masukkan username!');
                    return;
                }
                this.currentUser = username;
                this.showPage('tablePage');
            }

            logout() {
                this.currentUser = null;
                document.getElementById('usernameInput').value = '';
                this.showPage('loginPage');
            }

            // Mengubah input tambahan berdasarkan pilihan Role (Form Dinamis)
            toggleRoleFields() {
                const role = document.getElementById('inputRole').value;
                const container = document.getElementById('extraFieldContainer');
                if (role === 'Admin') {
                    container.innerHTML = `<input type="text" id="inputExtra" class="form-control" placeholder="Admin Level (Cth: SuperAdmin)">`;
                } else {
                    container.
